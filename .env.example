# ============================================================
# resume-cli 环境变量示例
#
# 使用方式：复制本文件为 .env 并填入真实值
#   cp .env.example .env
#
# 说明：.env 中的值只在"当前 shell 还没有同名环境变量"时生效，
#       也就是说真实环境变量（CI / Docker）的优先级更高。
# ============================================================

# 【必填】AI 服务的 API Key
OPENAI_API_KEY=sk-your-key-here

# 【可选】服务端点。只要是兼容 OpenAI /chat/completions 协议的服务都可以直接用：
#   OpenAI     https://api.openai.com/v1
#   DeepSeek   https://api.deepseek.com/v1
#   阿里云百炼  https://dashscope.aliyuncs.com/compatible-mode/v1
#   智谱 AI    https://open.bigmodel.cn/api/paas/v4
#   月之暗面    https://api.moonshot.cn/v1
#   本地 Ollama http://localhost:11434/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# 【可选】模型名，默认 gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# 【可选】单次请求超时（毫秒），默认 60000
AI_TIMEOUT_MS=60000

# 【可选】失败重试次数（不含首次请求），默认 2
AI_MAX_RETRIES=2

# 可选：使用 Codex CLI 的现有登录（不需要填写上面的 API Key）
# AI_PROVIDER=codex
# CODEX_MODEL=gpt-5.6-luna
# CODEX_BIN=/path/to/codex
# AI_TIMEOUT_MS=120000
